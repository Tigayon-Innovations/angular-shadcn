{
  "name": "@ng-cn/core",
  "version": "1.0.17",
  "description": "Beautifully designed Angular components built with Tailwind CSS v4 - The official Angular port of shadcn/ui",
  "keywords": [
    "angular",
    "components",
    "tailwind",
    "shadcn",
    "ui",
    "design-system",
    "angular-components"
  ],
  "author": "Jamel Eid Yassin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://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@github.com/Tigayon-Innovations/angular-shadcn.git"
  },
  "homepage": "https://shadcn-angular.tigayon.com/",
  "bugs": {
    "url": "https://github.com/Tigayon-Innovations/angular-shadcn/issues"
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "files": [
    "schematics",
    "src/app/lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:schematics": "tsc -p schematics/tsconfig.json",
    "build:mcp": "tsc -p mcp-server/tsconfig.json",
    "mcp:setup": "tsx mcp-server/setup-mcp.ts",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "serve:ssr:shadcn-angular": "node dist/shadcn-angular/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular-devkit/core": "^22.0.1",
    "@angular-devkit/schematics": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-server": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/ssr": "^22.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "apexcharts": "^5.10.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-angular": "^1.0.0",
    "ng-apexcharts": "^2.3.0",
    "ngx-sonner": "^3.1.0",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.0",
    "@analogjs/vitest-angular": "^2.3.1",
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@testing-library/angular": "^19.2.1",
    "@testing-library/dom": "^10.4.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.5.0",
    "jasmine-core": "~6.1.0",
    "jsdom": "^29.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
