{
  "name": "@ng-cn/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for ng-cn component documentation and installation",
  "type": "module",
  "main": "index.js",
  "bin": {
    "ng-cn-mcp": "./index.js"
  },
  "scripts": {
    "start:stdio": "node --loader ts-node/esm index.ts",
    "start:http": "node --loader ts-node/esm streamable-http-server.ts",
    "start:sse": "node --loader ts-node/esm http-server.ts",
    "dev:http": "tsx streamable-http-server.ts",
    "dev:sse": "tsx http-server.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shadcn",
    "angular",
    "components",
    "ui"
  ],
  "author": "ng-cn team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  }
}
