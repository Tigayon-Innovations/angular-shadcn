# Environment variables for Angular SSR Application
# Copy this file to .env.production and update values for your environment

# Application
NODE_ENV=production
PORT=4200
HOST=0.0.0.0

# Deployment
DEPLOY_DIR=/var/www/shadcn-angular
APP_USER=www-data
APP_GROUP=www-data

# Domain
DOMAIN=shadcn-angular.tigayon.com

# PM2
PM2_APP_NAME=shadcn-angular
PM2_MCP_NAME=mcp-server
PM2_HOME=/var/lib/www-data/.pm2

# MCP Server
MCP_PORT=3001
MCP_HOST=localhost
MCP_URL=https://shadcn-angular.tigayon.com/mcp
MCP_AUTH_ENABLED=true
MCP_AUTH_USERNAME=jamel
MCP_AUTH_PASSWORD=jamel

# Nginx
NGINX_CONFIG_DIR=/etc/nginx
NGINX_HTPASSWD=/etc/nginx/.htpasswd
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled

# SSL/TLS
SSL_CERT_PATH=/etc/letsencrypt/live/shadcn-angular.tigayon.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/shadcn-angular.tigayon.com/privkey.pem

# Logging
LOG_DIR=/var/log/shadcn-angular
NGINX_LOG_DIR=/var/log/nginx

# Backup
BACKUP_DIR=/var/backups/shadcn-angular

# Jenkins
JENKINS_HOME=/var/lib/jenkins
JENKINS_USER=jenkins
JENKINS_WORKSPACE=/var/lib/jenkins/workspace/shadcn-angular
