{
  "$schema": "http://json-schema.org/schema",
  "$id": "JamelYassinNgAddSchema",
  "title": "@jamelyassin/shadcn-angular ng-add schematic",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "The name of the project to add @jamelyassin/shadcn-angular to.",
      "$default": {
        "$source": "projectName"
      }
    },
    "skipInstall": {
      "type": "boolean",
      "default": false,
      "description": "Skip installing dependency packages."
    }
  }
}
